    "src/net/protocol.ts",
    "types/css-modules.d.ts",
    "types/shims/dsh-client-runtime.ts",
    "types/shims/dsh-client-ui-settings.ts",
    "types/shims/dsh-client-ui-slots.ts",
    "types/shims/dsh-client-ui-primitives.ts"
  ]
