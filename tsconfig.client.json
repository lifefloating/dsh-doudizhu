  "compilerOptions": {
    "rootDir": ".",
    "outDir": "lib/types",
    "noEmit": true,
    "jsx": "react-jsx",
    "allowJs": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/client",
    "src/join",
