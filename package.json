{
  "name": "dsh-poker",
  "version": "0.1.7",
  "description": "斗地主房间插件。三人/四人、经典/癞子，Host 权威房间 + 欢迎积分账本。",
  "author": "lifefloating",
  "license": "MIT",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "doudizhu",
    "poker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lifefloating/dsh-doudizhu.git"
  },
  "homepage": "https://github.com/lifefloating/dsh-doudizhu#readme",
  "bugs": {
    "url": "https://github.com/lifefloating/dsh-doudizhu/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "prepare.mjs"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "prepare": "node prepare.mjs",
    "build": "pnpm run clean && node scripts/emit-dts.mjs && tsdown --config tsdown.config.ts && tsdown --config tsdown.client.ts && tsdown --config tsdown.join.ts",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "verify": "pnpm typecheck && pnpm build && pnpm test",
    "release:check": "pnpm run verify && node scripts/check-package.mjs && git diff --check"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "gsap": "^3.13.0",
    "ws": "^8.18.3",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/schemastery": "*",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.18.1",
    "lightningcss": "^1.30.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
